[Unit]
Description=ai-summarized weekly review
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aisum
Group=aisum
EnvironmentFile=/etc/ai-summarized/worker.env
WorkingDirectory=/opt/ai-summarized/worker
ExecStart=/usr/bin/node dist/main.js weekly
# One model call. A run that hangs is ended.
TimeoutStartSec=15min

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
