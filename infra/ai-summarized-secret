#!/usr/bin/env bash
# Stores one secret of the worker in /etc/ai-summarized/worker.env.
# The value is typed or pasted at a prompt that does not echo it, so it never
# appears in a command line, a shell history or a log.
# Usage: ai-summarized-secret ANTHROPIC_API_KEY | SUPABASE_SECRET_KEY
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "run as root" >&2; exit 1; }
file=/etc/ai-summarized/worker.env
name=${1:-}
case $name in
  ANTHROPIC_API_KEY | SUPABASE_SECRET_KEY) ;;
  *) echo "usage: ai-summarized-secret ANTHROPIC_API_KEY | SUPABASE_SECRET_KEY" >&2; exit 2 ;;
esac
[[ -f $file ]] || { echo "$file is missing; run provision.sh first" >&2; exit 1; }

read -r -s -p "Value for $name (not shown): " value
echo
# Whitespace from a paste is dropped; anything else unusual is refused.
value=${value//[[:space:]]/}
[[ ${#value} -ge 20 ]] || { echo "that is too short to be a key; nothing was changed" >&2; exit 1; }
[[ $value =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "unexpected characters; nothing was changed" >&2; exit 1; }

# Written to a new file with the right owner and mode, then moved into place.
new=$(mktemp "$file.XXXXXX")
trap 'rm -f "$new"' EXIT
chown root:aisum "$new"
chmod 640 "$new"
grep -v "^$name=" "$file" > "$new" || true
printf '%s=%s\n' "$name" "$value" >> "$new"
mv "$new" "$file"
trap - EXIT
echo "$name stored (${#value} characters)."
